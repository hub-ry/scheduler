# Copy to /etc/scheduler.env, fill in, then:
#   sudo chown root:scheduler /etc/scheduler.env
#   sudo chmod 640 /etc/scheduler.env
#
# Not in the repo. Both of these are secrets.

# The shared password. Changing it signs everyone out.
SCHEDULER_PASSWORD=

# Compiled into the frontend bundle at build time, so ./serve picks it up when
# it rebuilds on start.
VITE_GOOGLE_CLIENT_ID=

# Served over https by the tunnel, so the session cookie can be secure.
SCHEDULER_SECURE_COOKIE=true

# Load the registrar tables into an empty database on first boot. Idempotent.
SCHEDULER_SEED_ON_START=true
