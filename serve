#!/usr/bin/env bash
#
# Build the frontend and serve everything from one process: ./serve
#
# This is what the systemd unit runs on the server. Locally you want ./dev
# instead - it runs the Vite dev server with hot reload, which this deliberately
# does not.
#
# Set SCHEDULER_PASSWORD to put the shared-password gate in front of the app.
# On anything reachable from outside the machine you want it set.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"

if [ ! -d "$BACKEND/.venv" ]; then
  echo "==> Creating the virtualenv"
  python -m venv "$BACKEND/.venv"
  "$BACKEND/.venv/bin/pip" install -q -e "$BACKEND"
fi

if [ ! -d "$FRONTEND/node_modules" ]; then
  echo "==> Installing frontend dependencies"
  npm --prefix "$FRONTEND" ci
fi

# Rebuilt every start rather than cached: a stale bundle serving old code is a
# confusing failure, and the build takes a couple of seconds.
echo "==> Building the frontend"
npm --prefix "$FRONTEND" run build

if [ -z "${SCHEDULER_PASSWORD:-}" ]; then
  echo "==> WARNING: SCHEDULER_PASSWORD is not set, so anyone with the URL can edit."
fi

cd "$BACKEND"
# Binds to localhost by default: the tunnel is what faces the internet, and a
# process listening on 0.0.0.0 would also be reachable from the LAN, bypassing
# it. Override HOST only if something else is doing the fronting.
exec .venv/bin/uvicorn app.main:app --host "${HOST:-127.0.0.1}" --port "${PORT:-8000}"
